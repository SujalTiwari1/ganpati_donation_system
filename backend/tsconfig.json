{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,

    "esModuleInterop": true,

    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "resolveJsonModule": true,

    "allowSyntheticDefaultImports": true,

    "sourceMap": true,

    "types": ["node","jest"]
  },

  "include": [
    "src",
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}