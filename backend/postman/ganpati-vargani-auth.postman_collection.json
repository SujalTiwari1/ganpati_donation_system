{
  "info": {
    "_postman_id": "b6f3a5e0-1a2d-4a4e-9b3c-ganpati-vargani-auth",
    "name": "Ganpati Vargani - Auth Module",
    "description": "End-to-end walkthrough of the auth module: login as the seeded admin, have the admin create a volunteer, log in as that volunteer, verify RBAC, then run negative/validation cases. Run top-to-bottom (or use Collection Runner) — each request stores what the next one needs into the environment automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Admin Bootstrap",
      "item": [
        {
          "name": "Login as Seeded Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('response has accessToken', () => pm.expect(json.data.accessToken).to.be.a('string'));",
                  "pm.test('user role is ADMIN', () => pm.expect(json.data.user.role).to.eql('ADMIN'));",
                  "pm.test('passwordHash is never returned', () => pm.expect(json.data.user).to.not.have.property('passwordHash'));",
                  "pm.environment.set('adminToken', json.data.accessToken);",
                  "pm.environment.set('adminUserId', json.data.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "This admin must already exist — run `npm run seed` once against your DB before this request will succeed. /auth/register requires an admin token, so the very first admin can never come from the API itself."
          },
          "response": []
        },
        {
          "name": "Get Admin Profile (GET /auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('role is ADMIN', () => pm.expect(json.data.role).to.eql('ADMIN'));",
                  "pm.test('id matches logged-in admin', () => pm.expect(json.data.id).to.eql(pm.environment.get('adminUserId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Admin Creates a Volunteer",
      "item": [
        {
          "name": "Register Volunteer",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Fresh email/mobile each run so re-running the collection doesn't 409 by accident.",
                  "const suffix = Date.now().toString().slice(-8);",
                  "pm.environment.set('volunteerEmail', `volunteer.${suffix}@example.com`);",
                  "pm.environment.set('volunteerMobile', `9${suffix}`);",
                  "pm.environment.set('volunteerPassword', 'Volunteer@123');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('created user has VOLUNTEER role', () => pm.expect(json.data.role).to.eql('VOLUNTEER'));",
                  "pm.test('passwordHash is never returned', () => pm.expect(json.data).to.not.have.property('passwordHash'));",
                  "pm.environment.set('volunteerUserId', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Volunteer\",\n  \"email\": \"{{volunteerEmail}}\",\n  \"mobile\": \"{{volunteerMobile}}\",\n  \"password\": \"{{volunteerPassword}}\",\n  \"role\": \"VOLUNTEER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "response": []
        },
        {
          "name": "Register Same Email Again (expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('success is false', () => pm.expect(pm.response.json().success).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Duplicate Attempt\",\n  \"email\": \"{{volunteerEmail}}\",\n  \"mobile\": \"9000000000\",\n  \"password\": \"Whatever@123\",\n  \"role\": \"VOLUNTEER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Reuses the email from the previous request on purpose to confirm the unique-email rule is enforced."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Volunteer Login & Access",
      "item": [
        {
          "name": "Login as Volunteer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('role is VOLUNTEER', () => pm.expect(json.data.user.role).to.eql('VOLUNTEER'));",
                  "pm.environment.set('volunteerToken', json.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{volunteerEmail}}\",\n  \"password\": \"{{volunteerPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          },
          "response": []
        },
        {
          "name": "Get Volunteer Profile (GET /auth/me)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('id matches registered volunteer', () => pm.expect(json.data.id).to.eql(pm.environment.get('volunteerUserId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{volunteerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          },
          "response": []
        },
        {
          "name": "Volunteer Attempts to Register (expect 403)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 403', () => pm.response.to.have.status(403));",
                  "pm.test('success is false', () => pm.expect(pm.response.json().success).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{volunteerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Should Not Be Created\",\n  \"email\": \"blocked@example.com\",\n  \"mobile\": \"9111111111\",\n  \"password\": \"Whatever@123\",\n  \"role\": \"VOLUNTEER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Confirms RBAC: a VOLUNTEER token must never be able to create users, even though it's a valid, authenticated token."
          },
          "response": []
        },
        {
          "name": "Volunteer Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{volunteerToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          },
          "response": []
        }
      ]
    },
    {
